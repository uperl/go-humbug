[
 {
  "id": "F01",
  "desc": "valid request and response",
  "expect": "valid",
  "req": {
   "method": "POST",
   "url": "/users",
   "headers": {
    "Content-Type": "application/json",
    "X-Request-Id": "abc"
   },
   "body": "{\"name\":\"Ann\",\"age\":30,\"profile\":{\"bio\":\"x\"}}"
  },
  "res": {
   "status": 201,
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "{\"id\":1,\"name\":\"Ann\"}"
  }
 },
 {
  "id": "F02",
  "desc": "wrong JSON property type",
  "expect": "request-invalid",
  "req": {
   "method": "POST",
   "url": "/users",
   "headers": {
    "Content-Type": "application/json",
    "X-Request-Id": "abc"
   },
   "body": "{\n  \"name\": \"Ann\",\n  \"age\": \"thirty\",\n  \"profile\": {\"bio\": \"x\"}\n}"
  }
 },
 {
  "id": "F03",
  "desc": "multiple independent invalid fields",
  "expect": "request-invalid",
  "req": {
   "method": "POST",
   "url": "/users",
   "headers": {
    "Content-Type": "application/json",
    "X-Request-Id": "abc"
   },
   "body": "{\"name\":\"\",\"age\":-1,\"email\":5,\"profile\":{\"bio\":\"x\"}}"
  }
 },
 {
  "id": "F04",
  "desc": "missing required nested property",
  "expect": "request-invalid",
  "req": {
   "method": "POST",
   "url": "/users",
   "headers": {
    "Content-Type": "application/json",
    "X-Request-Id": "abc"
   },
   "body": "{\"name\":\"Ann\",\"age\":3,\"profile\":{}}"
  }
 },
 {
  "id": "F04b",
  "desc": "type mismatch on object: redundant required errors?",
  "expect": "request-invalid",
  "req": {
   "method": "POST",
   "url": "/users",
   "headers": {
    "Content-Type": "application/json",
    "X-Request-Id": "abc"
   },
   "body": "{\"name\":\"Ann\",\"age\":3,\"profile\":\"oops\"}"
  }
 },
 {
  "id": "F05",
  "desc": "invalid query parameter",
  "expect": "request-invalid",
  "req": {
   "method": "GET",
   "url": "/users/7?limit=abc%20x"
  }
 },
 {
  "id": "F05b",
  "desc": "query out of range and bad path param",
  "expect": "request-invalid",
  "req": {
   "method": "GET",
   "url": "/users/notint?limit=500"
  }
 },
 {
  "id": "F06",
  "desc": "missing required header",
  "expect": "request-invalid",
  "req": {
   "method": "POST",
   "url": "/users",
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "{\"name\":\"Ann\",\"age\":3,\"profile\":{\"bio\":\"x\"}}"
  }
 },
 {
  "id": "F06b",
  "desc": "invalid header value (too short)",
  "expect": "request-invalid",
  "req": {
   "method": "POST",
   "url": "/users",
   "headers": {
    "Content-Type": "application/json",
    "X-Request-Id": "a"
   },
   "body": "{\"name\":\"Ann\",\"age\":3,\"profile\":{\"bio\":\"x\"}}"
  }
 },
 {
  "id": "F07",
  "desc": "unsupported request media type",
  "expect": "request-invalid",
  "req": {
   "method": "POST",
   "url": "/users",
   "headers": {
    "Content-Type": "text/plain",
    "X-Request-Id": "abc"
   },
   "body": "hello"
  }
 },
 {
  "id": "F08",
  "desc": "malformed JSON request body",
  "expect": "request-invalid",
  "req": {
   "method": "POST",
   "url": "/users",
   "headers": {
    "Content-Type": "application/json",
    "X-Request-Id": "abc"
   },
   "body": "{\n  \"name\": \"Ann\",\n  \"age\": 3,,\n}"
  }
 },
 {
  "id": "F09",
  "desc": "undocumented response status",
  "expect": "response-invalid",
  "req": {
   "method": "POST",
   "url": "/users",
   "headers": {
    "Content-Type": "application/json",
    "X-Request-Id": "abc"
   },
   "body": "{\"name\":\"Ann\",\"age\":3,\"profile\":{\"bio\":\"x\"}}"
  },
  "res": {
   "status": 418,
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "{}"
  }
 },
 {
  "id": "F10",
  "desc": "invalid JSON response body",
  "expect": "response-invalid",
  "req": {
   "method": "GET",
   "url": "/users/7"
  },
  "res": {
   "status": 200,
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "{\"id\":\"seven\"}"
  }
 },
 {
  "id": "F11",
  "desc": "oneOf zero matching branches",
  "expect": "request-invalid",
  "req": {
   "method": "POST",
   "url": "/contacts",
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "{\"fax\":\"1\"}"
  }
 },
 {
  "id": "F12",
  "desc": "oneOf multiple matching branches",
  "expect": "request-invalid",
  "req": {
   "method": "POST",
   "url": "/overlap",
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "{\"email\":\"a\"}"
  }
 },
 {
  "id": "F13",
  "desc": "anyOf no matching branches",
  "expect": "request-invalid",
  "req": {
   "method": "POST",
   "url": "/contacts-any",
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "{\"fax\":\"1\"}"
  }
 },
 {
  "id": "F14",
  "desc": "external $ref file",
  "expect": "request-invalid",
  "req": {
   "method": "POST",
   "url": "/addresses",
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "{\"street\":\"1 Main\",\"zip\":\"abc\"}"
  }
 },
 {
  "id": "F15",
  "desc": "unmatched path",
  "expect": "request-invalid",
  "req": {
   "method": "GET",
   "url": "/nope"
  }
 },
 {
  "id": "F15b",
  "desc": "unmatched method",
  "expect": "request-invalid",
  "req": {
   "method": "DELETE",
   "url": "/users"
  }
 },
 {
  "id": "F16",
  "desc": "invalid request plus invalid response",
  "expect": "both-invalid",
  "req": {
   "method": "POST",
   "url": "/users",
   "headers": {
    "Content-Type": "application/json",
    "X-Request-Id": "abc"
   },
   "body": "{\"name\":\"Ann\",\"age\":\"x\",\"profile\":{\"bio\":\"x\"}}"
  },
  "res": {
   "status": 201,
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "{\"id\":\"bad\"}"
  }
 },
 {
  "id": "F17",
  "desc": "valid cookie and array query",
  "expect": "valid",
  "req": {
   "method": "GET",
   "url": "/items?ids=1&ids=2",
   "headers": {
    "Cookie": "session=abcd"
   }
  },
  "res": {
   "status": 200,
   "headers": {
    "Content-Type": "application/json",
    "X-Rate-Limit": "5"
   },
   "body": "[{\"id\":1,\"name\":\"a\"}]"
  }
 },
 {
  "id": "F18",
  "desc": "missing required cookie",
  "expect": "request-invalid",
  "req": {
   "method": "GET",
   "url": "/items",
   "headers": {}
  }
 },
 {
  "id": "F19",
  "desc": "array query element wrong type",
  "expect": "request-invalid",
  "req": {
   "method": "GET",
   "url": "/items?ids=1&ids=x",
   "headers": {
    "Cookie": "session=abcd"
   }
  }
 },
 {
  "id": "F20",
  "desc": "response array item invalid and rate-limit header missing",
  "expect": "response-invalid",
  "req": {
   "method": "GET",
   "url": "/items",
   "headers": {
    "Cookie": "session=abcd"
   }
  },
  "res": {
   "status": 200,
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "[{\"id\":1,\"name\":\"a\"},{\"id\":\"2\",\"name\":\"b\"}]"
  }
 },
 {
  "id": "F21",
  "desc": "allOf: one branch fails independently",
  "expect": "request-invalid",
  "req": {
   "method": "POST",
   "url": "/orders",
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "{\"email\":\"a@b\",\"qty\":\"many\"}"
  }
 },
 {
  "id": "F22",
  "desc": "allOf: both branches fail",
  "expect": "request-invalid",
  "req": {
   "method": "POST",
   "url": "/orders",
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "{\"qty\":1,\"extra\":true}"
  }
 },
 {
  "id": "F23",
  "desc": "binary body to octet-stream operation (string/binary schema)",
  "expect": "valid",
  "req": {
   "method": "POST",
   "url": "/upload",
   "headers": {
    "Content-Type": "application/octet-stream"
   },
   "body": "\u0000\u0001binary"
  }
 },
 {
  "id": "F24",
  "desc": "text body shorter than minLength",
  "expect": "request-invalid",
  "req": {
   "method": "POST",
   "url": "/notes",
   "headers": {
    "Content-Type": "text/plain"
   },
   "body": "hi"
  }
 },
 {
  "id": "F25",
  "desc": "non-JSON text body ok",
  "expect": "valid",
  "req": {
   "method": "POST",
   "url": "/notes",
   "headers": {
    "Content-Type": "text/plain"
   },
   "body": "hello"
  }
 },
 {
  "id": "F26",
  "desc": "escaped key and unicode value, wrong type",
  "expect": "request-invalid",
  "req": {
   "method": "POST",
   "url": "/users",
   "headers": {
    "Content-Type": "application/json",
    "X-Request-Id": "abc"
   },
   "body": "{\"name\":\"Zoë\",\"age\":\"x\",\"profile\":{\"bio\":\"é\"},\"a/b\":1}"
  }
 },
 {
  "id": "F27",
  "desc": "label-style path param, valid",
  "expect": "request-invalid",
  "req": {
   "method": "GET",
   "url": "/label/.5"
  },
  "note": "KNOWN LIBRARY LIMITATION: pb33f v0.16.1 does not strip the label/matrix prefix, so this valid request is reported invalid."
 },
 {
  "id": "F28",
  "desc": "label-style path param, wrong type",
  "expect": "request-invalid",
  "req": {
   "method": "GET",
   "url": "/label/.x"
  }
 },
 {
  "id": "F29",
  "desc": "matrix-style path param, valid",
  "expect": "request-invalid",
  "req": {
   "method": "GET",
   "url": "/matrix/;id=5"
  },
  "note": "KNOWN LIBRARY LIMITATION: pb33f v0.16.1 does not strip the label/matrix prefix, so this valid request is reported invalid."
 },
 {
  "id": "F30",
  "desc": "matrix-style path param, wrong type",
  "expect": "request-invalid",
  "req": {
   "method": "GET",
   "url": "/matrix/;id=x"
  }
 },
 {
  "id": "F31",
  "desc": "simple array path param, valid",
  "expect": "valid",
  "req": {
   "method": "GET",
   "url": "/list/1,2,3"
  }
 },
 {
  "id": "F32",
  "desc": "simple array path param, bad item",
  "expect": "request-invalid",
  "req": {
   "method": "GET",
   "url": "/list/1,x,3"
  }
 },
 {
  "id": "F33",
  "desc": "composition failures on both sides (ID remapping across sides)",
  "expect": "both-invalid",
  "req": {
   "method": "POST",
   "url": "/both",
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "{\"fax\":1}"
  },
  "res": {
   "status": 200,
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "{\"pager\":2}"
  }
 },
 {
  "id": "F34",
  "desc": "unmatched operation with a response: response note is caused by the request finding",
  "expect": "request-invalid",
  "req": {
   "method": "GET",
   "url": "/nope"
  },
  "res": {
   "status": 200,
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "{}"
  }
 },
 {
  "id": "F35",
  "desc": "application/vcl body, valid UTF-8 string",
  "expect": "valid",
  "req": {
   "method": "PUT",
   "url": "/vcl",
   "headers": {
    "Content-Type": "application/vcl"
   },
   "body": "sub vcl_recv { }"
  }
 },
 {
  "id": "F36",
  "desc": "application/vcl body shorter than minLength",
  "expect": "request-invalid",
  "req": {
   "method": "PUT",
   "url": "/vcl",
   "headers": {
    "Content-Type": "application/vcl"
   },
   "body": "sub"
  }
 },
 {
  "id": "F37",
  "desc": "application/vcl with a non-UTF-8 charset is not inspected",
  "expect": "incomplete",
  "req": {
   "method": "PUT",
   "url": "/vcl",
   "headers": {
    "Content-Type": "application/vcl; charset=iso-8859-1"
   },
   "body": "sub vcl_recv { }"
  }
 },
 {
  "id": "F38",
  "desc": "non-JSON response body (2XX wildcard) violates its string schema",
  "expect": "response-invalid",
  "req": {
   "method": "PUT",
   "url": "/vcl",
   "headers": {
    "Content-Type": "application/vcl"
   },
   "body": "sub vcl_recv { }"
  },
  "res": {
   "status": 201,
   "headers": {
    "Content-Type": "application/vcl"
   },
   "body": ""
  }
 },
 {
  "id": "F39",
  "desc": "form body under an object schema stays incomplete",
  "expect": "incomplete",
  "req": {
   "method": "POST",
   "url": "/form",
   "headers": {
    "Content-Type": "application/x-www-form-urlencoded"
   },
   "body": "a=1"
  }
 },
 {
  "id": "F40",
  "desc": "media type declared without a schema: any content conforms",
  "expect": "valid",
  "req": {
   "method": "POST",
   "url": "/anycsv",
   "headers": {
    "Content-Type": "text/csv"
   },
   "body": "a,b\n1,2"
  }
 },
 {
  "id": "F41",
  "desc": "required header sent empty, schema allows empty (library says missing)",
  "expect": "valid",
  "req": {
   "method": "GET",
   "url": "/hdr",
   "headers": {
    "X-Any": ""
   }
  }
 },
 {
  "id": "F42",
  "desc": "optional header sent empty, minLength forbids it (library says valid)",
  "expect": "request-invalid",
  "req": {
   "method": "GET",
   "url": "/hdr",
   "headers": {
    "X-Any": "v",
    "X-Min": ""
   }
  }
 },
 {
  "id": "F43",
  "desc": "integer header sent empty",
  "expect": "request-invalid",
  "req": {
   "method": "GET",
   "url": "/hdr",
   "headers": {
    "X-Any": "v",
    "X-Num": ""
   }
  }
 },
 {
  "id": "F44",
  "desc": "response header present but not an integer",
  "expect": "response-invalid",
  "req": {
   "method": "GET",
   "url": "/hdr",
   "headers": {
    "X-Any": "v"
   }
  },
  "res": {
   "status": 200,
   "headers": {
    "X-Rate-Limit": "abc"
   }
  }
 },
 {
  "id": "F45",
  "desc": "response header sent lower-case and invalid: diagnostic uses the declared name",
  "expect": "response-invalid",
  "req": {
   "method": "GET",
   "url": "/hdr",
   "headers": {
    "X-Any": "v"
   }
  },
  "res": {
   "status": 200,
   "headers": {
    "x-rate-limit": "abc"
   }
  }
 },
 {
  "id": "F46",
  "desc": "Set-Cookie response header does not match its pattern",
  "expect": "response-invalid",
  "req": {
   "method": "GET",
   "url": "/items",
   "headers": {
    "Cookie": "session=abcd"
   }
  },
  "res": {
   "status": 200,
   "headers": {
    "Content-Type": "application/json",
    "X-Rate-Limit": "5",
    "Set-Cookie": "other=2"
   },
   "body": "[]"
  }
 }
]
